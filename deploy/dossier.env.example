# Production environment for the backend. Copy to /var/www/dossier/.env and edit.
#   cp deploy/dossier.env.example .env
#   chmod 600 .env
#
# Generate secrets with:
#   openssl rand -hex 32                                  # JWT_SECRET
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_NAME=Dossier
APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL. Use a URL-safe password (hex) to avoid encoding issues.
DATABASE_URL=postgresql+asyncpg://dossier:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/dossier

# Redis with a password. Note the colon before the password (no username).
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# Authentication
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_DOMAIN=
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Your console domain. Only needed for direct API calls; the Next.js rewrite is
# same-origin and does not trigger CORS.
CORS_ORIGINS=https://app.example.com

# Ollama on the same host, or an external endpoint.
# Ollama Cloud uses OLLAMA_BASE_URL=https://ollama.com plus OLLAMA_API_KEY.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=120

# Bootstrap values (only used by `python -m app.cli bootstrap`)
BOOTSTRAP_ORG_NAME=Your Organisation
BOOTSTRAP_DEPARTMENT_NAME=General
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_FULL_NAME=Platform Administrator

# Encrypts connector and SMTP credentials at rest. Back this up: without it, stored
# secrets cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEYS=v1:CHANGE_ME_FERNET_KEY
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=v1

# Daily connector sync at 02:00 UTC, and the lock TTL.
DAILY_SYNC_HOUR_UTC=2
SYNC_LOCK_TTL_SECONDS=1800

# Mail generation limits
MAIL_MAX_ROWS_PER_SOURCE=50
MAIL_AGGREGATE_ROW_CAP=2000
MAIL_MAX_PROMPT_CHARS=30000
MAIL_SEND_RETRIES=3
