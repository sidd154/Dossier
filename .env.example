# Application
APP_NAME=Dossier
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database (host port 5433 to avoid clashing with a local Postgres install)
DATABASE_URL=postgresql+asyncpg://dossier:dossier@localhost:5433/dossier
TEST_DATABASE_URL=postgresql+asyncpg://dossier:dossier@localhost:5433/dossier_test

# Redis (rate limiting now, Celery broker from Phase 2)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=replace-this-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Frontend origin allowed to call the API directly (dev only; the Next rewrite proxy
# normally keeps the browser same-origin)
CORS_ORIGINS=http://localhost:3000

# LLM (mail generation)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=deepseek-v4.1-flash:cloud

# Bootstrap (only read by `python -m app.cli bootstrap`)
BOOTSTRAP_ORG_NAME=Dossier
BOOTSTRAP_DEPARTMENT_NAME=General
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_FULL_NAME=Platform Administrator

# Credential encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple keys are allowed as key_id:key,key_id:key for rotation windows.
CREDENTIAL_ENCRYPTION_KEYS=v1:replace-with-a-generated-fernet-key
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=v1

# Daily sync and locking
DAILY_SYNC_HOUR_UTC=2
SYNC_LOCK_TTL_SECONDS=1800

# Mail engine
LLM_TIMEOUT_SECONDS=120
MAIL_MAX_ROWS_PER_SOURCE=50
MAIL_AGGREGATE_ROW_CAP=2000
MAIL_MAX_PROMPT_CHARS=30000
MAIL_SEND_RETRIES=3
